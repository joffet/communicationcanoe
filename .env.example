# PlanetScale Postgres — every table the app reads or writes, plus Better
# Auth's own (user, session, account, verification), which better-auth creates
# in the same database using this variable.
#
# Connect as comm_canoe_app rather than postgres: it owns nothing and holds no
# CREATE on the schema, which is what stops a leaked application credential
# from dropping a table. It cannot run DDL, by design.
#
# The username must be branch-qualified - PlanetScale's proxy rejects a bare
# `comm_canoe_app` before it reaches Postgres, with an error that reads like
# bad credentials and is not. See
# packages/database/sql/00-bootstrap-database-and-role.sql.
DATABASE_URL=postgresql://comm_canoe_app.[branch-id]:[password]@aws-ca-central-1-1.pg.psdb.cloud/comm_canoe?sslmode=require

# drizzle-kit only (packages/database/drizzle.config.ts) - never read at
# runtime. The durable `postgres` role, which is the one that can run DDL.
# Unset locally and drizzle-kit falls back to DATABASE_URL, which suits a
# throwaway database where both roles are the same.
MIGRATION_DATABASE_URL=postgresql://postgres.[branch-id]:[password]@aws-ca-central-1-1.pg.psdb.cloud/comm_canoe?sslmode=require

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Postmark (inbound)
POSTMARK_INBOUND_WEBHOOK_SECRET=

# AI (one provider required for live AI)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Internal (bridge ↔ web). Also signs the dashboard socket tokens the web app
# mints and the bridge verifies (apps/web/src/app/api/realtime/token).
INTERNAL_API_SECRET=
REALTIME_BRIDGE_URL=http://localhost:3001
CHAT_SESSION_SECRET=

# Realtime bridge (Railway realtime-bridge service)
REALTIME_BRIDGE_PORT=3001
# Where the browser opens its dashboard socket. Returned to the client by the
# token route, so it needs no NEXT_PUBLIC_ twin.
REALTIME_BRIDGE_PUBLIC_WS_URL=ws://localhost:3001
CHAT_HANDOFF_TIMEOUT_MS=90000
CHAT_SESSION_TTL_MS=604800000
NEXT_PUBLIC_CHAT_WIDGET_URL=http://localhost:3001/widget.js

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails auto-promoted to super_admin on login (optional bootstrap)
SUPER_ADMIN_EMAILS=

# Public URL for email image assets when running locally (optional)
# EMAIL_ASSET_BASE_URL=https://your-production-domain.com

# Amazon SES (outbound email — magic links, tenant replies)
AMAZON_SES_REGION=ca-central-1
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Default From when no tenant address is available (verified in SES)
DEFAULT_MAIL_FROM=info@communicationcanoe.com

# Voice bridge (backward-compatible alias — prefer REALTIME_BRIDGE_PORT)
# VOICE_BRIDGE_PORT=3001

# Reside integration (server-to-server; distinct from INTERNAL_API_SECRET, which is web<->realtime-bridge only)
RESIDE_API_SECRET=
# Symmetric key for verifying reside SSO tokens (v1 HMAC; see docs/reside-sso-contract.md)
RESIDE_SSO_SIGNING_SECRET=
# SES configuration set for outbound tenant-reply emails (enables delivery/bounce/complaint events)
SES_CONFIGURATION_SET_NAME=
# Path secret segment for the SES->SNS delivery-notification webhook
SES_SNS_WEBHOOK_SECRET=
# reside's API base, for comm-canoe -> reside calls (identity-status, resident-lookup, activity)
RESIDE_API_BASE=
# Sent as x-comm-canoe-secret on comm-canoe -> reside calls; must match reside's COMM_CANOE_API_SECRET
COMM_CANOE_API_SECRET=
