# Supabase (Postgres + Realtime only — auth is Better Auth in Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Better Auth (uses Supabase Postgres via DATABASE_URL)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Postmark (inbound)
POSTMARK_INBOUND_WEBHOOK_SECRET=

# AI (one provider required for live AI)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Internal (bridge ↔ web)
INTERNAL_API_SECRET=
REALTIME_BRIDGE_URL=http://localhost:3001
CHAT_SESSION_SECRET=

# Realtime bridge (Railway realtime-bridge service)
REALTIME_BRIDGE_PORT=3001
REALTIME_BRIDGE_PUBLIC_WS_URL=ws://localhost:3001
CHAT_HANDOFF_TIMEOUT_MS=90000
CHAT_SESSION_TTL_MS=604800000
NEXT_PUBLIC_CHAT_WIDGET_URL=http://localhost:3001/widget.js

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails auto-promoted to super_admin on login (optional bootstrap)
SUPER_ADMIN_EMAILS=

# Public URL for email image assets when running locally (optional)
# EMAIL_ASSET_BASE_URL=https://your-production-domain.com

# Amazon SES (outbound email — magic links, tenant replies)
AMAZON_SES_REGION=ca-central-1
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Default From when no tenant address is available (verified in SES)
DEFAULT_MAIL_FROM=info@communicationcanoe.com

# Voice bridge (backward-compatible alias — prefer REALTIME_BRIDGE_PORT)
# VOICE_BRIDGE_PORT=3001

# Reside integration (server-to-server; distinct from INTERNAL_API_SECRET, which is web<->realtime-bridge only)
RESIDE_API_SECRET=
# Symmetric key for verifying reside SSO tokens (v1 HMAC; see docs/reside-sso-contract.md)
RESIDE_SSO_SIGNING_SECRET=
# SES configuration set for outbound tenant-reply emails (enables delivery/bounce/complaint events)
SES_CONFIGURATION_SET_NAME=
# Path secret segment for the SES->SNS delivery-notification webhook
SES_SNS_WEBHOOK_SECRET=
# reside's API base, for comm-canoe -> reside calls (identity-status, resident-lookup, activity)
RESIDE_API_BASE=
# Sent as x-comm-canoe-secret on comm-canoe -> reside calls; must match reside's COMM_CANOE_API_SECRET
COMM_CANOE_API_SECRET=
